## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

*.pdb
*.tmp
*.log

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/*

# OS
.DS_Store
Thumbs.db

# Native library (downloaded at install time, not committed)
Plugins/DashEvolution/runtimes/
*.so
*.dll
*.dylib
